# Copy this file to .env and fill in your own key. .env is git-ignored.
# Get a free key at https://openrouter.ai/keys - no card required for :free models.
OPENROUTER_API_KEY=

# Free-tier model, verified live/working as of Sep 2026. The free model list
# on OpenRouter changes month to month - if this model has been retired, pick
# a current one from https://openrouter.ai/models?max_price=0 and paste its
# id here. No code change needed either way; if the key is missing or the
# call fails or is rate-limited, the app automatically falls back to
# deterministic template answers.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
